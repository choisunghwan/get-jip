{
  "name": "seonghwan-house",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "성환이 집 구하기 — 뇌처럼 얽힌 지식 그래프 + 재계산 엔진 + 카드 UX MVP",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify": "node src/engine/verify.js",
    "cf:db:create": "wrangler d1 create get-jip",
    "cf:db:migrate": "wrangler d1 migrations apply get-jip --remote",
    "cf:db:migrate:local": "wrangler d1 migrations apply get-jip --local",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:dev": "npm run build && wrangler dev"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.8",
    "wrangler": "^4.20.0"
  }
}
